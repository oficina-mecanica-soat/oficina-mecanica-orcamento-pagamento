{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "oficina-mecanica-auth",
    "Audience": "oficina-mecanica-api",
    "Secret": "",
    "ExpirationMinutes": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "ProcessamentoRemoto": {
    "Habilitado": false
  },
  "Integracoes": {
    "FluxoDistribuido": {
      "Habilitado": false
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "OficinaMecanica": "Information",
        "Serilog.AspNetCore": "Information"
      }
    }
  }
}
